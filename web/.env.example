# Copy to `.env.local` and fill in. Next.js reads env files from this folder only.
# Anything prefixed NEXT_PUBLIC_ ends up in the browser bundle: never put a secret here.

# The SiteProof API (backend/). Locally: http://localhost:4000
# The team's hosted API: https://hack.furqaannabi.com
NEXT_PUBLIC_API_URL=

# Where screens get their data. Empty or "mock": an in-browser demo that needs no
# backend. "api": the backend at NEXT_PUBLIC_API_URL.
NEXT_PUBLIC_DATA_SOURCE=

# Where the landing's "Open the demo" goes on the real API: the demo flat's report link,
# such as https://siteproof-alpha.vercel.app/report#<token>. A report link only, never a
# builder link, which would let anyone upload. Empty: the button goes to /projects.
NEXT_PUBLIC_DEMO_URL=
