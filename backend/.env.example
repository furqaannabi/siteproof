# Copy to `.env` and fill in. `.env` is gitignored and must stay that way:
# this repo is public. Names only in this file, never values.

# --- Meta Model API (SAM 3.1, Muse Spark, Voice Transcribe) ---
# Server-side only. Never expose to the browser, never log.
META_API_KEY=
META_API_BASE_URL=

# --- Database ---
# Postgres through Prisma. For the local database from compose.yaml (`pnpm db:up`):
#   postgresql://siteproof:siteproof@localhost:5432/siteproof
DATABASE_URL=

# --- Object storage for clips, frames and masks: Cloudflare R2 ---
# A private bucket. Access only through short-lived presigned URLs.
# STORAGE_ENDPOINT is the account-level S3 API, https://<account id>.r2.cloudflarestorage.com
# (without the bucket name); STORAGE_REGION is `auto`. Keys: an R2 API token with
# Object Read & Write.
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# --- API ---
PORT=4000
# Sites allowed to call the API from a browser, comma-separated, no trailing slash.
# Empty refuses every site. Locally and for the deployed frontend:
#   http://localhost:3000,https://siteproof-alpha.vercel.app
WEB_ORIGINS=

# Signs the upload tickets clips carry between asking for a link and completing.
# Any long random string, different on every machine and the server: openssl rand -hex 32
UPLOAD_TICKET_SECRET=

# --- Secret links (docs/decisions/2026-10-28-builder-access-by-secret-links-accepted.md) ---
# Signs every builder and report link. Changing it replaces every link at once.
# Any long random string, different on every machine and the server: openssl rand -hex 32
LINK_SECRET=
# The team's key for creating projects and fetching a project's links. Unset: nobody can.
SETUP_KEY=
