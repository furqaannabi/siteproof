// The SiteProof database. Models follow the data contract (docs/data-contract.md);
// a model here is never wider than the contract without Furqaan's say.
//
// Field names are the contract's, snake_case, so a row maps to a contract shape
// field for field. Where the contract carries a URL (Clip.url, Detection's frame and
// mask, Result.evidence) the database holds the R2 object key instead: URLs are
// presigned when they are read, and a key is never sent, logged or shown.
//
// Ids are random UUIDs, never sequential: an id in a URL must not be guessable.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ClipStatus {
  uploaded
  processing
  done
  failed
}

enum DocumentKind {
  demand_letter
  invoice
  boq
}

/// The contract's ItemKind: what this version can count.
enum ItemKind {
  window
  door
}

/// Claim.item: an ItemKind, or a line this version cannot count.
enum ClaimItem {
  window
  door
  not_countable
}

enum JobStatus {
  queued
  running
  done
  failed
}

model Project {
  id           String   @id @default(uuid())
  name         String
  builder      String
  /// The builder link's version. Replacing the link bumps it; the link itself is never stored.
  link_version Int      @default(1)
  created_at   DateTime @default(now())

  flats     Flat[]
  clips     Clip[]
  documents Document[]
}

model Flat {
  id           String @id @default(uuid())
  project_id   String
  name         String
  /// The report link's version. Replacing the link bumps it; the link itself is never stored.
  link_version Int    @default(1)

  project   Project    @relation(fields: [project_id], references: [id], onDelete: Cascade)
  rooms     Room[]
  documents Document[]

  @@index([project_id])
}

/// Room.flat in the contract is `flat_id` here.
model Room {
  id      String @id @default(uuid())
  flat_id String
  name    String
  /// What the printed tag decodes to. Unique, so a decoded tag names exactly one room.
  qr_code String @unique

  flat         Flat         @relation(fields: [flat_id], references: [id], onDelete: Cascade)
  segments     Segment[]
  claims       Claim[]
  detections   Detection[]
  gap_requests GapRequest[]
  cross_checks CrossCheck[]

  @@index([flat_id])
}

model Clip {
  id          String     @id @default(uuid())
  project_id  String
  /// The R2 object key. Never in a response, never logged, never shown.
  object_key  String     @unique
  /// null when the file carries no capture time. Never the upload time.
  captured_at DateTime?
  status      ClipStatus @default(uploaded)
  created_at  DateTime   @default(now())

  project      Project      @relation(fields: [project_id], references: [id], onDelete: Cascade)
  segments     Segment[]
  detections   Detection[]
  cross_checks CrossCheck[]

  @@index([project_id])
}

model Document {
  id         String       @id @default(uuid())
  project_id String
  /// null for a document that covers the whole project, such as a BOQ.
  flat_id    String?
  kind       DocumentKind
  status     ClipStatus   @default(uploaded)
  /// Why it failed, in plain words from a fixed list in code; null unless failed.
  reason     String?
  /// The R2 object key. Never in a response, never logged, never shown.
  object_key String       @unique
  created_at DateTime     @default(now())

  project Project @relation(fields: [project_id], references: [id], onDelete: Cascade)
  flat    Flat?   @relation(fields: [flat_id], references: [id], onDelete: Cascade)
  claims  Claim[]

  @@index([project_id])
}

/// The part of a clip that belongs to one room. A null room_id is unplaced.
model Segment {
  id         String  @id @default(uuid())
  clip_id    String
  room_id    String?
  t_start    Float
  t_end      Float
  full_sweep Boolean

  clip Clip  @relation(fields: [clip_id], references: [id], onDelete: Cascade)
  room Room? @relation(fields: [room_id], references: [id], onDelete: Cascade)

  @@index([clip_id])
  @@index([room_id])
}

model Claim {
  id             String    @id @default(uuid())
  doc_id         String
  item           ClaimItem
  qty            Int
  /// null where the document states no unit. Never filled in.
  unit           String?
  room_id        String?
  /// The document's line, word for word. Untrusted text: never rendered as markup.
  source_quote   String
  /// Set by code, never by a model.
  quote_verified Boolean

  document Document @relation(fields: [doc_id], references: [id], onDelete: Cascade)
  room     Room?    @relation(fields: [room_id], references: [id], onDelete: Cascade)

  @@index([doc_id])
  @@index([room_id])
}

/// One object SAM tracked within one clip.
model Detection {
  id             String   @id @default(uuid())
  clip_id        String
  room_id        String
  item           ItemKind
  track_id       String
  /// R2 object keys; the contract's best_frame_url and mask_url are presigned from these.
  best_frame_key String
  mask_key       String

  clip Clip @relation(fields: [clip_id], references: [id], onDelete: Cascade)
  room Room @relation(fields: [room_id], references: [id], onDelete: Cascade)

  @@unique([clip_id, item, track_id])
  @@index([room_id, item])
}

/// Stored as open or sent; "cleared" is worked out on read, from a full one-way sweep
/// of the room in a clip uploaded after the request.
enum GapRequestStatus {
  open
  sent
}

/// An exact, small ask for footage of a room that is Not seen yet.
/// See docs/decisions/2026-10-28-gap-request-text-and-pdf-export.md.
model GapRequest {
  id         String           @id @default(uuid())
  room_id    String
  /// Written by code from the flat and room names, never by a model.
  text       String
  /// Muse Spark's filming steps, checked, or the fixed steps in code.
  steps      String[]
  status     GapRequestStatus @default(open)
  created_at DateTime         @default(now())

  room Room @relation(fields: [room_id], references: [id], onDelete: Cascade)

  @@index([room_id])
}

/// Muse Spark's own count of an item in one clip's footage of one room. Internal to
/// the comparison engine: it can only hold an outcome back, never produce one.
model CrossCheck {
  id      String   @id @default(uuid())
  clip_id String
  room_id String
  item    ItemKind
  count   Int

  clip Clip @relation(fields: [clip_id], references: [id], onDelete: Cascade)
  room Room @relation(fields: [room_id], references: [id], onDelete: Cascade)

  @@unique([clip_id, room_id, item])
  @@index([room_id])
}

/// Pipeline work. Internal to the backend, not part of the contract.
/// See docs/decisions/2026-10-27-jobs-table.md.
model Job {
  id              String    @id @default(uuid())
  kind            String
  /// Ids only: never a presigned URL, an object key, or document text.
  payload         Json
  status          JobStatus @default(queued)
  attempts        Int       @default(0)
  max_attempts    Int       @default(3)
  run_after       DateTime  @default(now())
  locked_at       DateTime?
  /// A short code only, never a message that could carry a URL or document text.
  last_error_code String?
  created_at      DateTime  @default(now())

  @@index([status, run_after])
}
